# Copy to .env.local (git-ignored) and adjust. Both variables are optional.

# Base URL the browser uses for /ocr and /health requests.
# Unset (default) = same origin: in production the backend serves the
# frontend; in `npm run dev` the Vite dev server proxies to the backend
# (see VITE_DEV_PROXY_TARGET). Set it only to call a backend directly,
# e.g. one on another host. It is baked into the bundle at build time.
# VITE_API_BASE_URL=http://127.0.0.1:8001

# Dev server only: where `npm run dev` forwards /api, /ocr and /health.
# Default: http://127.0.0.1:8001 (web_service_unified.py default port).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8001
